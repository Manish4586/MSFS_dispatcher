# Discord Developer Portal bot token (keep secret)
DISCORD_BOT_TOKEN=PASTE_BOT_TOKEN_HERE
# Discord server (guild) ID
DISCORD_GUILD_ID=123456789012345678

# Redis on the Oracle VPS
REDIS_URL=redis://127.0.0.1:6379/0

# Optional dashboard/API shared key; keep it private
DASHBOARD_API_KEY=CHANGE_THIS_TO_A_LONG_RANDOM_SECRET

# Bind locally; expose through Nginx/Caddy reverse proxy
API_HOST=127.0.0.1
API_PORT=8787

# Absolute paths for Oracle VPS deployment
DATA_DIR=/home/manish4586/msfs/data
AIRPORTS_FILE=/home/manish4586/msfs/data/airports.csv
CORS_ORIGINS=*
